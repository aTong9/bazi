              "description": "主要有力十神及其功能｜列出对全局作用最明显的1—3个十神，说明其有效功能和作用对象。｜来源：M10/M14/M15｜Field_ID：M19-TEN-0019-V1.0"
            },
            "constrained_or_overused_ten_gods": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "受限、失效或过度十神｜记录力量虽存在但功能受限、转化、失效、过度或制化失衡的十神。｜来源：M10/M11/M16｜Field_ID：M19-TEN-0020-V1.0"
            },
            "ten_god_purity": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "十神清纯度与混杂｜判断官杀、食伤、印枭、正偏财等是否清纯、有杂、混杂及主从关系。｜来源：M10/M11/M15｜Field_ID：M19-TEN-0021-V1.0"
            },
            "established_ten_god_combinations": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "已成立十神组合｜输出达到弱成立以上的生化、制化、平衡承载或冲突组合及成立等级。｜来源：M11｜Field_ID：M19-COMBO-0022-V1.0"
            },
            "weak_or_rejected_combinations": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "弱成立、不成立与被否决组合｜记录表面十神齐全但因力量、位置、承载、破坏或救应不足而降级的组合。｜来源：M11｜Field_ID：M19-COMBO-0023-V1.0"
            },
            "dominant_function_chain": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "主导生化、制化与承载功能｜从全部组合中提取覆盖全局最广、对格局和病药最关键的主导功能轴。｜来源：M11/M12/M15/M16｜Field_ID：M19-COMBO-0024-V1.0"
            },
            "main_flow_path": {
