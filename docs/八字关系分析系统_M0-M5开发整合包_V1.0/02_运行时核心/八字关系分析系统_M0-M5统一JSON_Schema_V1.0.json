{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bazi:relationship-analysis:m0-m5:1.0",
  "title": "八字关系分析系统 M0-M5 统一输出结构 V1.0",
  "description": "整合M0原局结构引擎与M1-M5关系模型。结构结论、现实证据、适配状态与置信度分层；不输出唯一正缘、具体婚期、医学诊断或关系指令。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "system_version",
    "request_context",
    "subjects",
    "m0",
    "m1",
    "m2",
    "m3",
    "m4",
    "m5",
    "evidence",
    "provenance",
    "decision_log",
    "report",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "system_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "M0",
        "M1",
        "M2",
        "M3",
        "M4",
        "M5",
        "integration"
      ],
      "properties": {
        "M0": {
          "const": "1.9"
        },
        "M1": {
          "const": "0.2"
        },
        "M2": {
          "const": "0.8"
        },
        "M3": {
          "const": "0.6-partial"
        },
        "M4": {
          "const": "0.9"
        },
        "M5": {
          "const": "0.9"
        },
        "integration": {
          "const": "1.0"
        }
      }
    },
    "request_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "analysis_mode",
        "language",
        "generated_at",
        "traditional_spouse_star_policy"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "analysis_mode": {
          "type": "string",
          "enum": [
            "single_chart_structure",
            "single_chart_relationship_profile",
            "specific_partner_with_reality_data",
            "two_chart_supplementary",
            "calibration_case",
            "test"
          ]
        },
        "language": {
          "type": "string",
          "default": "zh-CN"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "traditional_spouse_star_policy": {
          "type": "string",
          "enum": [
            "enabled",
            "disabled",
            "custom"
          ]
        },
        "requested_sections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "privacy_mode": {
          "type": "string",
          "enum": [
            "standard",
            "anonymous",
            "calibration_anonymous"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "subjects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_a"
      ],
      "properties": {
        "subject_a": {
          "$ref": "#/$defs/birthSubject"
        },
        "subject_b": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/birthSubject"
            }
          ]
        },
        "relationship_context": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "m0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "version",
        "report_fields",
        "rule_trace",
        "disputes",
        "dependency_flags"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/moduleStatus"
        },
        "version": {
          "const": "1.9"
        },
        "report_fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_validation",
            "scope_boundary",
            "overall_confidence",
            "day_master_and_season",
            "pillar_element_ten_god_map",
            "roots_and_exposure",
            "natal_structure_summary",
            "identified_relations",
            "relation_effects",
            "pending_or_rejected_relations",
            "element_effective_strength_matrix",
            "element_strength_ranking",
            "strength_adjustment_reasons",
            "day_master_strength",
            "support_side_evidence",
            "load_side_evidence",
            "adjacent_grade_exclusion",
            "ten_god_status_matrix",
            "dominant_ten_gods",
            "constrained_or_overused_ten_gods",
            "ten_god_purity",
            "established_ten_god_combinations",
            "weak_or_rejected_combinations",
            "dominant_function_chain",
            "main_flow_path",
            "primary_flow_block",
            "secondary_blocks_and_alternatives",
            "bridge_candidates_and_side_effects",
            "temperature_state",
            "moisture_state",
            "climate_problem_and_urgency",
            "climate_candidates_and_conflicts",
            "pattern_candidates",
            "final_pattern",
            "pattern_evidence_and_level",
            "pattern_failure_factors",
            "pattern_rescue_and_alternatives",
            "root_disease",
            "secondary_diseases",
            "primary_and_auxiliary_medicine",
            "medicine_risks",
            "five_element_use_matrix",
            "primary_and_auxiliary_use",
            "favorable_unfavorable_roles",
            "final_structure_summary"
          ],
          "properties": {
            "input_validation": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "输入完整度与交节核验｜记录出生日期、时刻、时区、历法转换、节气交界及四柱输入是否足以支撑后续判断。｜来源：M02/M03｜Field_ID：M19-META-0001-V1.0"
            },
            "scope_boundary": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "分析适用范围与模型边界｜说明本报告只处理原局静态结构，并界定不包含岁运、具体事件、医学诊断和生活化补救。｜来源：M00/M16/M17/M18｜Field_ID：M19-META-0002-V1.0"
            },
            "overall_confidence": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "总体置信度与待核查项｜汇总M02—M18的低置信度、待定、流派争议和输入风险，给出总体置信等级。｜来源：M02-M18｜Field_ID：M19-META-0003-V1.0"
            },
            "day_master_and_season": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "日主与月令｜输出日主天干、阴阳五行、出生月令及月令的季节基础倾向。｜来源：M02/M03/M09｜Field_ID：M19-BASE-0004-V1.0"
            },
            "pillar_element_ten_god_map": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "四柱五行与十神映射｜逐柱记录天干、地支、藏干、阴阳五行及相对日主的十神映射。｜来源：M02/M10｜Field_ID：M19-BASE-0005-V1.0"
            },
            "roots_and_exposure": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "主要根气与透干｜汇总日主及关键五行/格神的根气位置、层级、透干和有效性。｜来源：M03/M07/M08｜Field_ID：M19-BASE-0006-V1.0"
            },
            "natal_structure_summary": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "原局结构总览｜用3—5条概括原局的主势、核心关系、主要功能轴和最显著矛盾。｜来源：M02-M08/M10-M13｜Field_ID：M19-BASE-0007-V1.0"
            },
            "identified_relations": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "已成立关系清单｜列出原局天干地支中客观成立的合、冲、刑、害、破、三合、三会等关系及参与柱位。｜来源：M04/M05｜Field_ID：M19-REL-0008-V1.0"
            },
            "relation_effects": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "关系实际效应｜将已成立关系转化为逐对象的合动、合绊、冲动、冲弱、冲散、刑动、改性及流通影响。｜来源：M06/M08/M12｜Field_ID：M19-REL-0009-V1.0"
            },
            "pending_or_rejected_relations": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "未成立与待定关系｜记录看似存在但未达到合化、成局、冲散、开库等严格条件的候选及否决原因。｜来源：M04/M05/M06｜Field_ID：M19-REL-0010-V1.0"
            },
            "element_effective_strength_matrix": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "五行有效旺衰矩阵｜分别输出木火土金水经月令、根气、透干、生源、合冲刑害、寒燥和流通修正后的有效旺衰。｜来源：M08｜Field_ID：M19-ELEM-0011-V1.0"
            },
            "element_strength_ranking": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "五行旺衰排序与主导气势｜给出五行有效力量的相对排序，并判断是否成势、聚势或存在两强对战。｜来源：M08/M12｜Field_ID：M19-ELEM-0012-V1.0"
            },
            "strength_adjustment_reasons": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "关键力量修正原因｜说明五行从原始旺衰到有效旺衰发生变化的关键原因。｜来源：M06/M07/M08｜Field_ID：M19-ELEM-0013-V1.0"
            },
            "day_master_strength": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "日主旺衰等级｜输出M09综合裁定的七级日主旺衰结论。｜来源：M09｜Field_ID：M19-DM-0014-V1.0"
            },
            "support_side_evidence": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "扶身侧核心证据｜汇总日主得令、得地、得势、得生和有效印比等主要正向证据。｜来源：M03/M08/M09｜Field_ID：M19-DM-0015-V1.0"
            },
            "load_side_evidence": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "负荷侧核心证据｜汇总官杀制身、食伤泄身、财星耗身及根损等主要负向证据。｜来源：M08/M09/M10｜Field_ID：M19-DM-0016-V1.0"
            },
            "adjacent_grade_exclusion": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "相邻等级排除与结论置信度｜说明为什么未判为相邻的更旺或更弱等级，并记录反向证据和置信度。｜来源：M09/M18｜Field_ID：M19-DM-0017-V1.0"
            },
            "ten_god_status_matrix": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "十神状态总表｜按比劫、印星、食伤、财星、官杀分组输出存在方式、有效力量、清纯度和功能状态。｜来源：M10｜Field_ID：M19-TEN-0018-V1.0"
            },
            "dominant_ten_gods": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
