            },
            "moisture_state": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "湿度状态｜输出经水势、湿土、燥土、火势和木疏土作用修正后的湿度轴等级。｜来源：M13｜Field_ID：M19-CLIMATE-0030-V1.0"
            },
            "climate_problem_and_urgency": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "主要气候问题与调候紧急度｜判断寒凝、火炎、湿滞、燥枯是否已形成实际功能障碍及其优先级。｜来源：M13/M16｜Field_ID：M19-CLIMATE-0031-V1.0"
            },
            "climate_candidates_and_conflicts": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "调候候选、有效性与跨模块冲突｜输出调候五行的存在性、有效性、主辅关系及其与扶抑、格局、通关的冲突。｜来源：M13/M17/M18｜Field_ID：M19-CLIMATE-0032-V1.0"
            },
            "pattern_candidates": {
