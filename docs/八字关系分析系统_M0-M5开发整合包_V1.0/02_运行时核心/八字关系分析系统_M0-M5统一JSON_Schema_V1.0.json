            },
            "pattern_failure_factors": {
              "allOf": [
                {
                  "$ref": "#/$defs/resultItem"
                }
              ],
              "description": "破格因素与破格等级｜输出直接影响格神或核心结构的破格因素、作用对象和轻微至根本破格等级。｜来源：M15/M16｜Field_ID：M19-PATTERN-0036-V1.0"
            },
            "pattern_rescue_and_alternatives": {
