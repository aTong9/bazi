{
  "name": "@bazi/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "files": ["src"],
  "description": "Deterministic BaZi chart engine and relationship analysis foundation.",
  "scripts": {
