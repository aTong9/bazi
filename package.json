  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "lunar-typescript": "1.8.6"
  },
  "devDependencies": {
    "@types/node": "24.2.1",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
