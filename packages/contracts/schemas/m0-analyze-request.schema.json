{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bazi.local/schemas/m0-analyze-request-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["analysis_mode", "subject", "requested_sections"],
  "properties": {
    "analysis_mode": { "enum": ["test", "production"] },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_mode", "subject_id", "four_pillars", "birth_time_status", "data_quality"],
      "properties": {
        "input_mode": { "const": "four_pillars_provided" },
        "subject_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "four_pillars": {
          "type": "object",
          "additionalProperties": false,
          "required": ["year", "month", "day", "hour"],
          "properties": {
            "year": { "$ref": "#/$defs/pillar" },
            "month": { "$ref": "#/$defs/pillar" },
            "day": { "$ref": "#/$defs/pillar" },
            "hour": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/pillar" }] }
          }
        },
        "birth_time_status": { "enum": ["exact", "approximate", "unknown"] },
        "timezone": { "type": "string", "minLength": 1 },
        "data_quality": { "enum": ["high", "medium", "low", "unknown"] },
        "synthetic_fixture": { "type": "boolean" }
      }
    },
    "requested_sections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["m0", "dynamic_timing"] }
    }
  },
  "$defs": {
    "pillar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stem", "branch"],
      "properties": {
        "stem": { "enum": ["甲", "乙", "丙", "丁", "戊", "己", "庚", "辛", "壬", "癸"] },
        "branch": { "enum": ["子", "丑", "寅", "卯", "辰", "巳", "午", "未", "申", "酉", "戌", "亥"] }
      }
    }
  }
}
